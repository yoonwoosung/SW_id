# FarmLink 환경변수 예시 — 실제 값은 .env에 넣고, .env는 커밋하지 않는다.
# 사용법: 이 파일을 .env로 복사한 뒤 각 값을 채운다.  cp .env.example .env

# Flask 세션 서명 키
SECRET_KEY=

# 데이터베이스 (운영 MySQL)
DB_USERNAME=
DB_PASSWORD=
DB_HOST=
DB_NAME=

# 카카오 로컬 API (지오코딩: 주소→좌표) — external/kakao_map.py
KAKAO_API_KEY=3d0f24818fc1a6b94e3f1100c091ec44
KAKAO_JS_KEY=fc2a43633b60b857fe9cb6594a9e7f0f
# CLOVA Studio (후기 감정/키워드 분석) — external/clova_api.py
CLOVA_API_KEY=
CLOVA_HOST=
CLOVA_ENDPOINT=

# 한국관광공사 주변 시설 API (없으면 DUMMY 기본값으로 동작, 실패 시 빈 목록 반환)
PET_API_KEY=              # 반려동물 동반여행 — external/pet_travel_api.py
BARRIER_FREE_API_KEY=     # 무장애 여행 — external/barrier_free_api.py
MEDICAL_API_KEY=          # 의료관광 — external/medical_tour_api.py
