# FarmLink 환경변수 예시. 실제 값을 채워 .env 로 복사해서 사용한다(.env 는 절대 커밋 금지).
#   cp .env.example .env  후 값 입력

# --- Flask ---
SECRET_KEY=change-me            # Flask 세션 서명용 비밀키(임의의 긴 문자열)
DEBUG=False                     # 로컬 개발에서 디버그를 켤 때만 true (프로덕션은 False)

# --- DB (PythonAnywhere MySQL) ---
DB_USERNAME=                    # PA: 보통 본인 계정명
DB_PASSWORD=                    # PA MySQL 비밀번호
DB_HOST=<user>.mysql.pythonanywhere-services.com   # PA MySQL 호스트
DB_NAME=<user>$farmlink         # PA: <계정명>$<DB이름> 형식

# --- Kakao ---
KAKAO_API_KEY=                  # 서버측 주소→좌표 지오코딩(REST API 키)
KAKAO_JS_KEY=                   # 카카오맵 JS SDK 키(브라우저 지도)

# --- CLOVA (후기 분석) ---
CLOVA_API_KEY=                  # CLOVA Studio API 키
CLOVA_HOST=https://clovastudio.stream.ntruss.com   # CLOVA 호스트
CLOVA_ENDPOINT=                 # CLOVA 요청 경로(엔드포인트)

# --- 공공데이터 TourAPI ---
TOUR_API_KEY=                   # data.go.kr 서비스키(주변 관광/맛집 코스)
