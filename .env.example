# FarmLink 환경변수 예시.
# 실제 값을 채워 .env 로 복사해서 사용한다. .env 는 절대 커밋 금지.
#   cp .env.example .env
# 서버(PythonAnywhere)에서는 프로젝트 루트에 .env 를 직접 만들어 값을 넣는다.
# app.py 가 import 시점에 load_dotenv() 로 이 경로의 .env 를 읽는다.

# --- Flask ---
# 세션 쿠키 서명용 비밀키. 반드시 길고 예측 불가능한 임의 문자열로.
#   생성 예: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- DB (PythonAnywhere MySQL) ---
# app.py 에서 mysql+mysqlconnector://<USER>:<PW>@<HOST>/<NAME> 형태로 조립된다.
DB_USERNAME=                                        # PA 계정명과 동일한 경우가 많음
DB_PASSWORD=                                        # PA Databases 탭에서 설정한 MySQL 비밀번호
DB_HOST=<user>.mysql.pythonanywhere-services.com    # PA Databases 탭에 표시되는 호스트
DB_NAME=<user>$farmlink                             # PA 규칙: <계정명>$<DB이름>

# --- Kakao ---
# 서버측 주소→좌표 지오코딩 (REST API 키) — external/kakao_map.py
KAKAO_API_KEY=
# 브라우저 카카오맵 JS SDK 키 — app.py → common/context.py 로 템플릿에 주입됨.
# 비워두면 지도가 렌더링되지 않으므로 반드시 채울 것.
KAKAO_JS_KEY=

# --- CLOVA Studio (후기 감정/키워드 분석) — external/clova_api.py ---
CLOVA_API_KEY=
CLOVA_HOST=https://clovastudio.stream.ntruss.com     # CLOVA 호스트
CLOVA_ENDPOINT=                                      # 요청 경로(엔드포인트)

# --- 공공데이터포털(data.go.kr) 주변 시설 API ---
# 미설정 시 코드가 DUMMY 기본값으로 동작하고 호출 실패 시 빈 목록을 반환한다.
TOUR_API_KEY=            # 주변 관광/맛집 코스        — external/tour_api.py
PET_API_KEY=             # 반려동물 동반 여행지        — external/pet_travel_api.py
MEDICAL_API_KEY=         # 의료 관광 정보             — external/medical_tour_api.py
BARRIER_FREE_API_KEY=    # 무장애(배리어프리) 여행지   — external/barrier_free_api.py
