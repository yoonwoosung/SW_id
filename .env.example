# FarmLink 환경변수 예시.
# 실제 값을 채워 .env 로 복사해서 사용한다. .env 는 절대 커밋 금지.
#   cp .env.example .env
# 서버(PythonAnywhere)에서는 프로젝트 루트에 .env 를 직접 만들어 값을 넣는다.
# app.py 가 import 시점에 load_dotenv() 로 이 경로의 .env 를 읽는다.
#
# ★ 주석은 반드시 키 "위" 줄에 쓸 것.
#   `KEY=            # 설명` 형태로 쓰면 값이 빈 상태일 때 python-dotenv가
#   주석 문자열을 값으로 읽어버린다(값이 있을 때만 인라인 주석이 제거됨).

# --- Flask ---
# 세션 쿠키 서명용 비밀키. 비워두면 로그인·flash 가 전부 500 난다.
#   생성: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- DB (PythonAnywhere MySQL) ---
# app.py 에서 mysql+mysqlconnector://<USER>:<PW>@<HOST>/<NAME> 형태로 조립된다.
# PA 계정명과 동일한 경우가 많음
DB_USERNAME=
# PA Databases 탭에서 설정한 MySQL 비밀번호
DB_PASSWORD=
# PA Databases 탭에 표시되는 호스트. 예: myid.mysql.pythonanywhere-services.com
DB_HOST=
# PA 규칙 <계정명>$<DB이름>. 예: myid$farmlink
DB_NAME=

# --- Kakao ---
# 서버측 주소→좌표 지오코딩 (REST API 키) — external/kakao_map.py
KAKAO_API_KEY=
# 브라우저 카카오맵 JS SDK 키 — app.py → common/context.py 로 템플릿에 주입.
# 비우면 지도가 렌더링되지 않는다.
KAKAO_JS_KEY=

# --- CLOVA Studio (후기 감정/키워드 분석) — external/clova_api.py ---
CLOVA_API_KEY=
# CLOVA 호스트. 기본값 예: https://clovastudio.stream.ntruss.com
CLOVA_HOST=
# CLOVA 요청 경로(엔드포인트)
CLOVA_ENDPOINT=

# --- 공공데이터포털(data.go.kr) 주변 시설 API ---
# 아래 4개는 키를 "빈 문자열"로 두면 그대로 빈 값이 쓰여 API 호출이 실패하고
# 빈 목록이 반환된다. 코드의 DUMMY 기본값은 키가 아예 정의되지 않았을 때만 쓰인다.
# 쓰지 않을 API 는 줄 전체를 지우는 편이 낫다.
# 주변 관광/맛집 코스 — external/tour_api.py
TOUR_API_KEY=
# 반려동물 동반 여행지 — external/pet_travel_api.py
PET_API_KEY=
# 의료 관광 정보 — external/medical_tour_api.py
MEDICAL_API_KEY=
# 무장애(배리어프리) 여행지 — external/barrier_free_api.py
BARRIER_FREE_API_KEY=
